{
    "name": "horde/auth",
    "description": "Authentication and user management library",
    "type": "horde-library",
    "homepage": "https://www.horde.org/libraries/Horde_Auth",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-31",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "dev-FRAMEWORK_6_0 || ^3 || ^2",
        "php": "^7.4 || ^8",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "ext-hash": "*"
    },
    "require-dev": {
        "horde/db": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/history": "^3 || dev-FRAMEWORK_6_0",
        "horde/lock": "^3 || dev-FRAMEWORK_6_0",
        "horde/imap_client": "^3 || dev-FRAMEWORK_6_0",
        "horde/kolab_session": "^3 || dev-FRAMEWORK_6_0",
        "horde/ldap": "^3 || dev-FRAMEWORK_6_0",
        "horde/imsp": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "ext-ctype": "*",
        "ext-ftp": "*",
        "ext-pam": "*",
        "ext-sasl": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Auth": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Auth\\Test\\": "test/",
            "Horde\\Auth\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}